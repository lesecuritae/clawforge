POSTGRES_DB=clawforge
POSTGRES_USER=clawforge
# Published release images. Use CLAWFORGE_IMAGE_TAG=local with --build for a local build.
CLAWFORGE_IMAGE_REGISTRY=ghcr.io/lesecuritae
CLAWFORGE_IMAGE_TAG=v1.0.0
CLAWFORGE_POSTGRES_SECRET_FILE=./secrets/postgres_password
CLAWFORGE_DATABASE_URL_SECRET_FILE=./secrets/database_url
CLAWFORGE_DATABASE_API_PASSWORD_SECRET_FILE=./secrets/database_api_password
CLAWFORGE_DATABASE_API_URL_SECRET_FILE=./secrets/database_api_url
CLAWFORGE_DATABASE_WORKER_PASSWORD_SECRET_FILE=./secrets/database_worker_password
CLAWFORGE_DATABASE_WORKER_URL_SECRET_FILE=./secrets/database_worker_url
CLAWFORGE_DATABASE_CORRELATION_PASSWORD_SECRET_FILE=./secrets/database_correlation_password
CLAWFORGE_DATABASE_CORRELATION_URL_SECRET_FILE=./secrets/database_correlation_url
CLAWFORGE_DATABASE_INCIDENTS_PASSWORD_SECRET_FILE=./secrets/database_incidents_password
CLAWFORGE_DATABASE_INCIDENTS_URL_SECRET_FILE=./secrets/database_incidents_url
CLAWFORGE_DATABASE_EXECUTOR_PASSWORD_SECRET_FILE=./secrets/database_executor_password
CLAWFORGE_DATABASE_EXECUTOR_URL_SECRET_FILE=./secrets/database_executor_url
CLAWFORGE_DATABASE_BACKUP_PASSWORD_SECRET_FILE=./secrets/database_backup_password
CLAWFORGE_API_HOST=127.0.0.1
CLAWFORGE_API_PORT=8080
CLAWFORGE_FRONTEND_HOST=127.0.0.1
CLAWFORGE_FRONTEND_PORT=3000
CLAWFORGE_ADMIN_BOOTSTRAP_USERNAME=admin
# Set this to a file containing a high-entropy one-time bootstrap token.
CLAWFORGE_ADMIN_BOOTSTRAP_SECRET_FILE=./secrets/admin_bootstrap_token
CLAWFORGE_ANALYZER_SECRET_FILE=./secrets/analyzer_token
CLAWFORGE_ANALYZER_API_KEY_SECRET_FILE=./secrets/analyzer_api_key
CLAWFORGE_ANALYZER_PROVIDER=mock
CLAWFORGE_ANALYZER_MODEL=offline
CLAWFORGE_ANALYZER_TIMEOUT_SECONDS=30
CLAWFORGE_ANALYZER_ANONYMIZE_IPS=true
# Required while CLAWFORGE_ANALYZER_ANONYMIZE_IPS is true (the default):
# events, alerts and analysis input refuse to persist or reveal a raw IP
# without this key, and use it to turn one into a stable, non-reversible
# pseudonym instead (same IP always yields the same pseudonym, so
# correlation still works; a different IP yields a different one, so
# unrelated events can no longer be fused together by a shared placeholder).
CLAWFORGE_ANALYZER_IP_HMAC_KEY_SECRET_FILE=./secrets/analyzer_ip_hmac_key
CLAWFORGE_ANALYZER_EVENT_CONSUMER=false
CLAWFORGE_ANALYZER_EVENT_POLL_SECONDS=10
CLAWFORGE_NOTIFIER_SECRET_FILE=./secrets/notifier_token
CLAWFORGE_OPERATIONS_SECRET_FILE=./secrets/operations_token
CLAWFORGE_NOTIFIER_POLL_SECONDS=5
CLAWFORGE_NOTIFIER_TIMEOUT_SECONDS=15
# Exact comma-separated DNS names; empty disables all notification egress.
CLAWFORGE_NOTIFIER_ALLOWED_HOSTS=
CLAWFORGE_NOTIFICATION_WEBHOOK_SECRET_FILE=./secrets/notifier_webhook_auth
CLAWFORGE_NOTIFICATION_MATRIX_SECRET_FILE=./secrets/notifier_matrix_auth
CLAWFORGE_NOTIFICATION_SMTP_SECRET_FILE=./secrets/notifier_smtp_password
CLAWFORGE_EVENTS_SECRET_FILE=./secrets/events_token
CLAWFORGE_EVENTS_POLL_SECONDS=5
CLAWFORGE_CORRELATION_POLL_SECONDS=5
CLAWFORGE_CORRELATION_WINDOW_SECONDS=900
CLAWFORGE_INCIDENT_POLL_SECONDS=5
CLAWFORGE_AGENT_API_URL=http://clawforge-api:8080
CLAWFORGE_MCP_AGENT_TOKEN_FILE=./secrets/mcp_agent_api_token
CLAWFORGE_MCP_AUTH_TOKEN_FILE=./secrets/mcp_auth_token
CLAWFORGE_MCP_SCOPES=agent:operations:read,agent:operations:briefing,agent:operations:recommend,agent:operations:state,agent:context:read,agent:decision:read,agent:incident:read,agent:provider:read,agent:security:read,agent:knowledge:read,agent:workflow:read,agent:connector:read,agent:action:read,agent:execution:read
# Comma-separated Host authorities to accept in addition to the built-in
# localhost/127.0.0.1/::1 loopback allowlist. Required whenever the MCP
# client is not in clawforge-mcp's own network namespace, which is the usual
# case: set this to "${CLAWFORGE_MCP_BACKEND_IP}:8090" (the defaults below)
# for a same-host client such as OpenClaw.
CLAWFORGE_MCP_ALLOWED_HOSTS=10.77.77.90:8090
# `backend`'s subnet and clawforge-mcp's fixed address on it. `backend` is
# `internal: true`, so this is a same-host-only address, not a route from
# the internet; change these only if 10.77.77.0/24 collides with another
# Docker network on this host.
CLAWFORGE_BACKEND_SUBNET=10.77.77.0/24
CLAWFORGE_MCP_BACKEND_IP=10.77.77.90
CLAWFORGE_GITHUB_TOKEN_FILE=./secrets/github_token
CLAWFORGE_PROXMOX_TOKEN_FILE=./secrets/proxmox_token
# Opt-in `sensors` profile (clawforge-linux-sensor,
# clawforge-haproxy-sensor). Both credential files start empty
# (init-secrets.sh does not generate them): run
# `cargo run -p clawforge-api --bin register-security-sensor -- <name>`
# against the database once per sensor and paste its printed credential in
# here - it is shown only that one time. Also verify CLAWFORGE_JOURNAL_GID
# below matches this host's `getent group systemd-journal` output (both
# sensors read the same host journal).
CLAWFORGE_LINUX_SENSOR_CREDENTIAL_SECRET_FILE=./secrets/linux_sensor_credential
CLAWFORGE_HAPROXY_SENSOR_CREDENTIAL_SECRET_FILE=./secrets/haproxy_sensor_credential
CLAWFORGE_SECURITY_EVENTS_URL=http://clawforge-api:8080
CLAWFORGE_JOURNAL_GID=101
CLAWFORGE_MCP_UPSTREAM_TIMEOUT_SECONDS=10
CLAWFORGE_WORKER_POLL_SECONDS=60
CLAWFORGE_ENABLE_FEEDS=false
CLAWFORGE_ENABLE_NETWORK=false
REDIS_URL=
CLAWFORGE_SCHEDULER_LOCK_KEY=clawforge:scheduler:lock
CLAWFORGE_THREATFOX_SECRET_FILE=./secrets/threatfox_auth_key
CLAWFORGE_URLHAUS_SECRET_FILE=./secrets/urlhaus_auth_key
CLAWFORGE_MALWAREBAZAAR_SECRET_FILE=./secrets/malwarebazaar_auth_key
CLAWFORGE_BACKUP_INTERVAL_SECONDS=86400
CLAWFORGE_BACKUP_RETENTION_DAYS=14
CLAWFORGE_BACKUP_DIR=./backups
RUST_LOG=info
# Optional observability profile (loopback-only by default)
CLAWFORGE_PROMETHEUS_HOST=127.0.0.1
CLAWFORGE_PROMETHEUS_PORT=9090
CLAWFORGE_GRAFANA_HOST=127.0.0.1
CLAWFORGE_GRAFANA_PORT=3001
CLAWFORGE_EXECUTOR_DRY_RUN=true
CLAWFORGE_EXECUTOR_POLL_SECONDS=10
